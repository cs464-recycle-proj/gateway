# ======================================
# Gateway Service Environment Variables
# ======================================
# Copy this file to .env and fill in the actual values
# DO NOT commit the .env file to version control

# ======================================
# JWT Configuration
# ======================================
# Base64-encoded secret key for JWT signature verification
# Must match the secret used by auth service
# Generate with: openssl rand -base64 32
JWT_SECRET=your-base64-encoded-secret-key-at-least-256-bits-long-here

# Name of the HTTP cookie containing the JWT token
JWT_COOKIE_NAME=jwt_token

# ======================================
# Microservice URLs
# ======================================
# Use service names for Docker Compose (e.g., http://auth-service:8081)
# Use localhost for local development (e.g., http://localhost:8081)

# Auth Service - Handles authentication and OTP verification
AUTH_SERVICE_URL=http://auth-service:8081

# User Service - Manages user profiles and preferences
USER_SERVICE_URL=http://user-service:8082

# Event Service - Handles event management
EVENT_SERVICE_URL=http://event-service:8083

# Gamification Service - Handles gamification features
GAMIFICATION_SERVICE_URL=https://gamification.linyucong.com

# ======================================
# CORS Configuration
# ======================================
# Comma-separated list of allowed frontend origins
# For local development: http://localhost:3000
# For production: https://your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
